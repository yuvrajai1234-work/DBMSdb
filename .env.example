# LumiSafe · Supabase (PostgreSQL)
# Copy this file to .env and paste the URI from
# Supabase -> Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Optional
# PORT=4173
# HOST=127.0.0.1
# SKIP_DB_MIGRATE=1   # do not create/refresh tables at startup
